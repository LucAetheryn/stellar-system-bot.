# ============================================================
# Stellar System V2 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ============================================================

# Your Discord bot token (from https://discord.com/developers/applications)
TOKEN=your_bot_token_here

# Your main guild (server) ID — right-click server → Copy ID (enable Developer Mode)
GUILD_ID=your_guild_id_here

# (Optional) Staff role ID used for ticket system permissions
STAFF_ROLE_ID=your_staff_role_id_here

# (Optional) Bot owner Discord user ID for owner-only commands
OWNER_ID=your_discord_user_id_here
